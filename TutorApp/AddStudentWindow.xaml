<Window x:Class="TutorApp.AddStudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление ученика" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F4F1EA" FontFamily="Segoe UI"
        BorderBrush="#3E2723" BorderThickness="2">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Новый ученик" FontSize="22" FontWeight="Bold" Foreground="#3E2723" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Фамилия:" FontWeight="Bold" Foreground="#3E2723"/>
            <TextBox Name="txtLastName" Height="30" Margin="0,5,0,10" Padding="5,0" BorderBrush="#3E2723" BorderThickness="1" VerticalContentAlignment="Center"/>

            <TextBlock Text="Имя:" FontWeight="Bold" Foreground="#3E2723"/>
            <TextBox Name="txtFirstName" Height="30" Margin="0,5,0,10" Padding="5,0" BorderBrush="#3E2723" BorderThickness="1" VerticalContentAlignment="Center"/>

            <TextBlock Text="Класс (например, 9А):" FontWeight="Bold" Foreground="#3E2723"/>
            <TextBox Name="txtGradeLevel" Height="30" Margin="0,5,0,10" Padding="5,0" BorderBrush="#3E2723" BorderThickness="1" VerticalContentAlignment="Center"/>

            <TextBlock Text="Предмет:" FontWeight="Bold" Foreground="#3E2723"/>
            <TextBox Name="txtSubject" Height="30" Margin="0,5,0,10" Padding="5,0" BorderBrush="#3E2723" BorderThickness="1" VerticalContentAlignment="Center"/>

            <TextBlock Text="Телефон:" FontWeight="Bold" Foreground="#3E2723"/>
            <TextBox Name="txtPhone" Height="30" Margin="0,5,0,20" Padding="5,0" BorderBrush="#3E2723" BorderThickness="1" VerticalContentAlignment="Center"/>

            <Button Content="Сохранить" Height="40" Background="#8CA0C4" Foreground="White" 
        FontWeight="Bold" FontSize="14" Cursor="Hand" Click="SaveButton_Click"
        BorderBrush="#3E2723" BorderThickness="2">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3E2723"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>