<Window x:Class="TutorApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TutorApp"
        mc:Ignorable="d"
        Title="Вход в систему" Height="480" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#4E342E" FontFamily="Segoe UI">
   
    <Border Background="#F4F1EA" CornerRadius="10" Margin="30" Padding="25">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Личный кабинет" FontSize="24" FontWeight="Bold" 
                       Foreground="#3E2723" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="репетитора" FontSize="18" Foreground="#8CA0C4" 
                       HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <TextBlock Text="Логин:" FontSize="14" FontWeight="SemiBold" Foreground="#3E2723"/>
            <TextBox Name="txtLogin" Height="35" Margin="0,5,0,15" Padding="5,0" FontSize="14"
                     VerticalContentAlignment="Center" BorderBrush="#8CA0C4" BorderThickness="1"/>

            <TextBlock Text="Пароль:" FontSize="14" FontWeight="SemiBold" Foreground="#3E2723"/>
            <PasswordBox Name="txtPassword" Height="35" Margin="0,5,0,20" Padding="5,0" FontSize="14"
                         VerticalContentAlignment="Center" BorderBrush="#8CA0C4" BorderThickness="1"/>

            <Button Name="btnLogin" Content="Войти" Height="40" Margin="0,0,0,10"
                    Background="#5D6D8A" Foreground="White" 
                    FontSize="15" FontWeight="Bold" Cursor="Hand" Click="btnLogin_Click"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Name="btnGoToRegister" Content="Нет аккаунта? Зарегистрироваться" 
                    Background="Transparent" Foreground="#5D6D8A" 
                    BorderThickness="0" Click="btnGoToRegister_Click"
                    FontWeight="SemiBold" FontSize="13" Cursor="Hand"/>
        </StackPanel>
    </Border>
</Window>