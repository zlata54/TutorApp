<Window x:Class="TutorApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TutorApp"
        mc:Ignorable="d"
        Title="Вход в систему" Height="450" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F4F1EA" FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="TextColor" Color="#3E2723"/>
        <SolidColorBrush x:Key="AccentColor" Color="#8CA0C4"/>
        <SolidColorBrush x:Key="AccentHover" Color="#5D6D8A"/>
    </Window.Resources>

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Личный кабинет репетитора" FontSize="22" FontWeight="Bold" 
                       Foreground="{StaticResource TextColor}"
                       HorizontalAlignment="Center" Margin="0,0,0,30" TextWrapping="Wrap" TextAlignment="Center"/>

            <TextBlock Text="Логин:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}"/>
            <TextBox Name="txtLogin" Height="35" Margin="0,5,0,15" Padding="5,0" FontSize="14"
                     VerticalContentAlignment="Center" BorderBrush="{StaticResource AccentColor}"/>

            <TextBlock Text="Пароль:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextColor}"/>
            <PasswordBox Name="txtPassword" Height="35" Margin="0,5,0,15" Padding="5,0" FontSize="14"
                         VerticalContentAlignment="Center" BorderBrush="{StaticResource AccentColor}"/>

            <Button Name="btnLogin" Content="Войти" Height="40" Margin="0,10,0,10"
                    Background="{StaticResource AccentColor}" Foreground="White" 
                    FontSize="14" FontWeight="SemiBold" Cursor="Hand" Click="btnLogin_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Name="btnGoToRegister" Content="Нет аккаунта? Зарегистрироваться" 
                    Background="Transparent" Foreground="{StaticResource AccentHover}" 
                    BorderThickness="0" Click="btnGoToRegister_Click"
                    FontWeight="Normal" FontSize="13" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>