<Window x:Class="TutorApp.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TutorApp"
        mc:Ignorable="d"
        Title="Регистрация" Height="520" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#4E342E" FontFamily="Segoe UI">

    <Border Background="#F4F1EA" CornerRadius="10" Margin="30" Padding="25">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Создание аккаунта" FontSize="22" FontWeight="Bold" 
                       Foreground="#3E2723" HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <TextBlock Text="Логин:" FontSize="14" FontWeight="SemiBold" Foreground="#3E2723"/>
            <TextBox Name="txtNewLogin" Height="35" Margin="0,5,0,15" Padding="5,0" FontSize="14"
                     VerticalContentAlignment="Center" BorderBrush="#8CA0C4" BorderThickness="1"/>

            <TextBlock Text="Пароль:" FontSize="14" FontWeight="SemiBold" Foreground="#3E2723"/>
            <PasswordBox Name="txtNewPassword" Height="35" Margin="0,5,0,15" Padding="5,0" FontSize="14"
                         VerticalContentAlignment="Center" BorderBrush="#8CA0C4" BorderThickness="1"/>

            <TextBlock Text="Повторите пароль:" FontSize="14" FontWeight="SemiBold" Foreground="#3E2723"/>
            <PasswordBox Name="txtConfirmPassword" Height="35" Margin="0,5,0,20" Padding="5,0" FontSize="14"
                         VerticalContentAlignment="Center" BorderBrush="#8CA0C4" BorderThickness="1"/>

            <Button Name="btnRegister" Content="Зарегистрироваться" Height="40" Margin="0,0,0,10"
                    Background="#5D6D8A" Foreground="White" 
                    FontSize="15" FontWeight="Bold" Cursor="Hand" Click="btnRegister_Click"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Name="btnBackToLogin" Content="Назад ко входу" 
                    Background="Transparent" Foreground="#5D6D8A" 
                    BorderThickness="0" Click="btnBackToLogin_Click"
                    FontWeight="SemiBold" FontSize="13" Cursor="Hand"/>
        </StackPanel>
    </Border>
</Window>