<Window x:Class="TutorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Личный кабинет репетитора" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F4F1EA" FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#3E2723" Foreground="White">
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="Ученики">
                <Grid Margin="10">
                    <DataGrid Name="StudentsDataGrid" AutoGenerateColumns="True" IsReadOnly="True"/>
                </Grid>
            </TabItem>
            <TabItem Header="Расписание">
                <TextBlock Text="Расписание" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </TabItem>
            <TabItem Header="Финансы">
                <TextBlock Text="Финансы" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>